      fontText: {fileID: 12800000, guid: 7eb656912aac97d478656f541412a954, type: 3}
      fontStyleText: 0
      Sentences: "\u0412 \u0442\u0435\u0447\u0435\u043D\u0438\u0438 \u044F\u043D\u0432\u0430\u0440\u044F
        \u0446\u0435\u043D\u0430 \u043D\u0430 \u044F\u0431\u043B\u043E\u043A\u0438
        \u0432\u044B\u0440\u043E\u0441\u043B\u0430 \u043D\u0430 30%, \u0430 \u0432
        \u0442\u0435\u0447\u0435\u043D\u0438\u0435 \u0444\u0435\u0432\u0440\u0430\u043B\u044F
        \u043D\u0430 20%. \u041D\u0430 \u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043E\u0432 \u043F\u043E\u0434\u043D\u044F\u043B\u0430\u0441\u044C
        \u0446\u0435\u043D\u0430 \u043D\u0430 2 \u043C\u0435\u0441\u044F\u0446\u0430?
        (\u0432\u0432\u0435\u0434\u0438\u0442\u0435 \u043E\u0442\u0432\u0435\u0442
        \u0431\u0435\u0437 \"\u043D\u0430) "
      Answer: 56%
      EndDialog:
