      fontStyleText: 0
      Sentences: "\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043B\u0435\u0441
        \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442 \u043F\u043B\u043E\u0449\u0430\u0434\u044C
        1000 \u0433\u0435\u043A\u0442\u0430\u0440\u043E\u0432. \u0415\u0436\u0435\u0433\u043E\u0434\u043D\u043E
        \u043F\u043B\u043E\u0449\u0430\u0434\u044C \u043B\u0435\u0441\u0430 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
