        \u043B\u0435\u0442 \u043F\u043B\u043E\u0449\u0430\u0434\u044C \u043B\u0435\u0441\u0430
        \u0434\u043E\u0441\u0442\u0438\u0433\u043D\u0435\u0442 1200 \u0433\u0435\u043A\u0442\u0430\u0440\u043E\u0432?
