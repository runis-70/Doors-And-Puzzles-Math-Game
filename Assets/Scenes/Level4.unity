        T=10log(t), \u0433\u0434\u0435 T - \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430
        \u0432 \u0433\u0440\u0430\u0434\u0443\u0441\u0430\u0445 \u0426\u0435\u043B\u044C\u0441\u0438\u044F,
