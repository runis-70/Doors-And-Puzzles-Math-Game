      fontStyleText: 0
      Sentences: "\u0422\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0443
        \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435 \u043C\u043E\u0436\u043D\u043E
