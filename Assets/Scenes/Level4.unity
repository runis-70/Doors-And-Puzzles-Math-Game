      fontText: {fileID: 12800000, guid: 7eb656912aac97d478656f541412a954, type: 3}
      fontStyleText: 0
      Sentences: "\u0418\u0437\u0432\u0435\u0441\u0442\u043D\u043E, \u0447\u0442\u043E
        \u0433\u0440\u043E\u043C\u043A\u043E\u0441\u0442\u044C \u0437\u0432\u0443\u043A\u0430
        L \u0432 \u0434\u0435\u0446\u0438\u0431\u0435\u043B\u0430\u0445 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442\u0441\u044F
        \u0444\u043E\u0440\u043C\u0443\u043B\u043E\u0439 L=10log(I), \u0433\u0434\u0435
        I - \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0441\u0442\u044C
        \u0437\u0432\u0443\u043A\u0430 \u0432 \u0432\u0430\u0442\u0442\u0430\u0445
        \u043D\u0430 \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u044B\u0439
        \u043C\u0435\u0442\u0440. \u041A\u0430\u043A\u043E\u0432\u0430 \u0431\u0443\u0434\u0435\u0442
        \u0433\u0440\u043E\u043C\u043A\u043E\u0441\u0442\u044C \u0437\u0432\u0443\u043A\u0430
        \u043E\u0442 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430, \u0438\u0437\u043B\u0443\u0447\u0430\u044E\u0449\u0435\u0433\u043E
