        100 \u0432\u0430\u0442\u0442 \u043D\u0430 \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u044B\u0439
        \u043C\u0435\u0442\u0440? (\u0432\u0432\u0435\u0434\u0438\u0442\u0435 \u043E\u0442\u0432\u0435\u0442
        \u0432 \u0434\u0435\u0446\u0438\u0431\u0435\u043B\u0430\u0445)"
